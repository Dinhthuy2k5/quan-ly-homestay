# =====================================================================
# HỆ THỐNG QUẢN LÝ VẬN HÀNH HOMESTAY - .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. Non-code / Project Documentation & AI Assistant
# ---------------------------------------------------------------------
# Tài liệu dự án (Word .docx, ảnh sơ đồ .png)
docs/

# Bộ kỹ năng / prompt cho AI assistant
skills/

# Local helper batch scripts
*.bat

# Modernization tool artifacts
.github/modernize/

# ---------------------------------------------------------------------
# 2. Runtime Storage & Uploads
# ---------------------------------------------------------------------
# Bỏ qua toàn bộ file upload khi chạy thực tế, chỉ giữ cấu trúc thư mục
storage/
storage/uploads/*
!storage/uploads/.gitkeep
!storage/uploads/**/.gitkeep

# ---------------------------------------------------------------------
# 3. Backend (Java / Spring Boot / Maven)
# ---------------------------------------------------------------------
**/target/
homestay-backend/target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Local configuration overrides & secrets
homestay-backend/src/main/resources/application-local.yaml
homestay-backend/src/main/resources/application-local.yml
homestay-backend/src/main/resources/application-local.properties

# ---------------------------------------------------------------------
# 4. Frontend (React / Vite / Node.js)
# ---------------------------------------------------------------------
**/node_modules/
frontend/node_modules/
**/dist/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint_cache/

# Local env & secret overrides
**/.env
!.env.example
**/.env.local
**/.env.*.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ---------------------------------------------------------------------
# 5. IDE & Code Editors
# ---------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
nbdist/
.nb-gradle/

# ---------------------------------------------------------------------
# 6. Logs & Diagnostics
# ---------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# 7. OS & Temporary Files
# ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.DS_Store
.AppleDouble
.LSOverride
Icon?

*.tmp
*.bak
*.swp
*.swo
*~
scratch*
