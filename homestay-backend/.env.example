DB_URL=jdbc:mysql://localhost:3306/homestayv4?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password

# Generate with: 32 random bytes encoded as Base64. Do not reuse a sample value.
JWT_SECRET=replace-with-base64-encoded-32-random-bytes

# Gmail SMTP uses an App Password, not the account's regular password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-sender@gmail.com

FRONTEND_URL=http://localhost:5173
